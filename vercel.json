{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/handler.mjs": {
      "includeFiles": "{data/*.json,.build/session-key}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/handler"}
  ]
}
